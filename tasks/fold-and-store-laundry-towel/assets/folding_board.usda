#usda 1.0
(
    defaultPrim = "FoldingBoard"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "FoldingBoard"
{
    def Cube "FixedHalf" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </FoldingBoard/Lining>
        float physxCollision:contactOffset = 0.0012
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.21, 0.38, 0.39)]
        double size = 1
        float3 xformOp:scale = (0.191, 0.18, 0.01)
        double3 xformOp:translate = (-0.099, 0, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Riser" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.19, 0.28, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.17, 0.155, 0.015)
        double3 xformOp:translate = (-0.1, 0, -0.0175)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "Flap" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.28
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "Panel" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FoldingBoard/Lining>
            float physxCollision:contactOffset = 0.0012
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.22, 0.44, 0.44)]
            double size = 1
            float3 xformOp:scale = (0.19, 0.291, 0.01)
            double3 xformOp:translate = (0.098, 0, -0.005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Capsule "GripStem" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.030886890422960996
            color3f[] primvars:displayColor = [(0.29, 0.48, 0.35)]
            double radius = 0.0045
            quatd xformOp:orient = (0.9680282217274293, 0.25084130827922047, 0, -0)
            double3 xformOp:translate = (0.174, -0.14750000000000002, 0.0115)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Sphere "GripKnob" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FoldingBoard/Lining>
            float physxCollision:contactOffset = 0.0012
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.51, 0.64, 0.43)]
            double radius = 0.013
            double3 xformOp:translate = (0.174, -0.155, 0.025)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Capsule "OpenStem" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double height = 0.03807886552931954
            color3f[] primvars:displayColor = [(0.36, 0.29, 0.25)]
            double radius = 0.0045
            quatd xformOp:orient = (0.5005175097501856, 0.8657264131545674, 0, -0)
            double3 xformOp:translate = (0.174, -0.15749999999999997, -0.0185)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Sphere "OpenKnob" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </FoldingBoard/Lining>
            float physxCollision:contactOffset = 0.0012
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.68, 0.36, 0.25)]
            double radius = 0.013
            double3 xformOp:translate = (0.174, -0.174, -0.028)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsRevoluteJoint "Hinge" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.009
        float drive:angular:physics:stiffness = 0
        uniform token physics:axis = "Y"
        rel physics:body1 = </FoldingBoard/Flap>
        point3f physics:localPos0 = (0.31, 0, 0.735)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -173
        float physics:upperLimit = 0
    }

    def Material "Lining" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.84
        float physics:staticFriction = 0.95
    }
}

