    def "YamLayoutMaterials"
    {
        def Material "GraphitePowderCoat"
        {
            token outputs:surface.connect = </root/YamLayoutMaterials/GraphitePowderCoat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.06, 0.065)
                float inputs:metallic = 0.45
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "RubberFeet"
        {
            token outputs:surface.connect = </root/YamLayoutMaterials/RubberFeet/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.02, 0.022)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
