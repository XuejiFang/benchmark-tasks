#usda 1.0
(
    defaultPrim = "WrappedSandwich"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WrappedSandwich" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.061
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cube "Package" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.31, 0.54, 0.32)]
        double size = 1
        float3 xformOp:scale = (0.056, 0.031, 0.027)
        double3 xformOp:translate = (0, 0, 0.0135)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "FoldedPullTab" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.72, 0.81, 0.58)]
        double size = 1
        float3 xformOp:scale = (0.019, 0.017, 0.01)
        double3 xformOp:translate = (0, 0, 0.032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "PaperLabel"
    {
        color3f[] primvars:displayColor = [(0.72, 0.81, 0.58)]
        double size = 1
        float3 xformOp:scale = (0.034, 0.028, 0.0004)
        double3 xformOp:translate = (0, 0, 0.0272)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

