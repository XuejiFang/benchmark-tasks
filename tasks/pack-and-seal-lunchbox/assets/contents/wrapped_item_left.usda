#usda 1.0
(
    defaultPrim = "WrappedSnack"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "WrappedSnack" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.045
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cube "Package" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.77, 0.39, 0.13)]
        double size = 1
        float3 xformOp:scale = (0.056, 0.031, 0.027)
        double3 xformOp:translate = (0, 0, 0.0135)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "FoldedPullTab" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.94, 0.75, 0.29)]
        double size = 1
        float3 xformOp:scale = (0.019, 0.017, 0.01)
        double3 xformOp:translate = (0, 0, 0.032)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "PaperLabel"
    {
        color3f[] primvars:displayColor = [(0.94, 0.75, 0.29)]
        double size = 1
        float3 xformOp:scale = (0.034, 0.028, 0.0004)
        double3 xformOp:translate = (0, 0, 0.0272)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

