#usda 1.0
(
    defaultPrim = "Scoop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Scoop" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.034

    def Cube "Floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.59, 0.64, 0.68)]
        double size = 1
        float3 xformOp:scale = (0.025, 0.026, 0.002)
        double3 xformOp:translate = (-0.002, 0, 0.001)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Heel" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.59, 0.64, 0.68)]
        double size = 1
        float3 xformOp:scale = (0.002, 0.026, 0.009)
        double3 xformOp:translate = (-0.014, 0, 0.0055)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Left" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.59, 0.64, 0.68)]
        double size = 1
        float3 xformOp:scale = (0.025, 0.002, 0.007)
        double3 xformOp:translate = (-0.002, 0.0125, 0.0045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Right" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.59, 0.64, 0.68)]
        double size = 1
        float3 xformOp:scale = (0.025, 0.002, 0.007)
        double3 xformOp:translate = (-0.002, -0.0125, 0.0045)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.26, 0.33, 0.37)]
        double size = 1
        float3 xformOp:scale = (0.008, 0.009, 0.068)
        double3 xformOp:translate = (-0.013, 0, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Mesh "Bevel" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 1, 3, 4, 5, 0, 1, 4, 3, 1, 2, 5, 4, 2, 0, 3, 5]
        uniform token physics:approximation = "convexHull"
        custom float physxCollision:contactOffset = 0.00048
        custom float physxCollision:restOffset = 0
        point3f[] points = [(0.0105, -0.013, 0), (0.016, -0.013, 0), (0.0105, -0.013, 0.002), (0.0105, 0.013, 0), (0.016, 0.013, 0), (0.0105, 0.013, 0.002)]
        color3f[] primvars:displayColor = [(0.59, 0.64, 0.68)]
        uniform token subdivisionScheme = "none"
    }
}

