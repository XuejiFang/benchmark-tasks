#usda 1.0
(
    defaultPrim = "Cap"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cap" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.027

    def Cylinder "Plate" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        double height = 0.006
        custom float physxCollision:contactOffset = 0.00065
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.2, 0.39, 0.27)]
        double radius = 0.0415
        double3 xformOp:translate = (0, 0, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "InnerRim" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        double height = 0.003
        custom float physxCollision:contactOffset = 0.00065
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.2, 0.39, 0.27)]
        double radius = 0.035
        double3 xformOp:translate = (0, 0, -0.0015)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Knob" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        double height = 0.02
        custom float physxCollision:contactOffset = 0.00065
        custom float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.19, 0.23, 0.22)]
        double radius = 0.009
        double3 xformOp:translate = (0, 0, 0.016)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

